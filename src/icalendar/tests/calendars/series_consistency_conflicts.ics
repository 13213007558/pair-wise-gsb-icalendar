BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//icalendar tests//series consistency//EN
BEGIN:VEVENT
UID:ok-series@example.com
DTSTAMP:20260101T000000Z
DTSTART;VALUE=DATE:20260101
DTEND;VALUE=DATE:20260102
RRULE:FREQ=DAILY;COUNT=10
RDATE;VALUE=DATE:20260301
EXDATE;VALUE=DATE:20260103
SUMMARY:Healthy all-day series
END:VEVENT
BEGIN:VEVENT
UID:ok-series@example.com
DTSTAMP:20260101T000000Z
RECURRENCE-ID;VALUE=DATE:20260105
DTSTART;VALUE=DATE:20260105
DTEND;VALUE=DATE:20260107
SUMMARY:Healthy two-day exception
END:VEVENT
BEGIN:VEVENT
UID:date-form@example.com
DTSTAMP:20260101T000000Z
DTSTART;VALUE=DATE:20260201
DTEND;VALUE=DATE:20260201
RRULE:FREQ=DAILY;COUNT=5;UNTIL=20260210T000000Z
SUMMARY:All-day master with datetime UNTIL
END:VEVENT
BEGIN:VEVENT
UID:date-form@example.com
DTSTAMP:20260101T000000Z
RECURRENCE-ID:20260203T090000Z
DTSTART:20260203T090000Z
DTEND:20260203T100000Z
SUMMARY:Exception uses DATE-TIME against DATE master
END:VEVENT
BEGIN:VEVENT
UID:date-form@example.com
DTSTAMP:20260101T000000Z
RECURRENCE-ID:20260203T090000Z
DTSTART:20260211T090000Z
SUMMARY:Same original instance, different moved DTSTART
END:VEVENT
BEGIN:VEVENT
UID:time-form@example.com
DTSTAMP:20260101T000000Z
DTSTART:20260301T090000Z
DURATION:-PT1H
RRULE:FREQ=DAILY;UNTIL=20260310T090000
RDATE;TZID=America/New_York:20260305T090000
EXDATE;VALUE=DATE:20260306
X-APPLE-CREATOR-IDENTITY:preserve-me
SUMMARY:UTC series with mismatched times and negative duration
END:VEVENT
BEGIN:VEVENT
UID:time-form@example.com
DTSTAMP:20260101T000000Z
DTSTART:20260301T090000Z
DTEND:20260301T100000Z
SUMMARY:Second master for the same UID
END:VEVENT
BEGIN:VEVENT
UID:both-end@example.com
DTSTAMP:20260101T000000Z
DTSTART;VALUE=DATE:20260401
DTEND;VALUE=DATE:20260331
DURATION:P1D
RRULE:FREQ=WEEKLY
SUMMARY:DTEND and DURATION present and end before start
END:VEVENT
BEGIN:VEVENT
UID:this-and-future@example.com
DTSTAMP:20260101T000000Z
DTSTART;VALUE=DATE:20260501
RRULE:FREQ=DAILY
SUMMARY:Infinite series, not expanded
END:VEVENT
BEGIN:VEVENT
UID:this-and-future@example.com
DTSTAMP:20260101T000000Z
RECURRENCE-ID;RANGE=THISANDFUTURE;VALUE=DATE:20260510
DTSTART;VALUE=DATE:20260510
SUMMARY:Earlier THISANDFUTURE claim
END:VEVENT
BEGIN:VEVENT
UID:this-and-future@example.com
DTSTAMP:20260101T000000Z
RECURRENCE-ID;RANGE=THISANDFUTURE;VALUE=DATE:20260520
DTSTART;VALUE=DATE:20260520
SUMMARY:Later THISANDFUTURE claim
END:VEVENT
BEGIN:VEVENT
UID:broken@example.com
DTSTAMP:20260101T000000Z
DTSTART:NOT-A-DATE
RRULE:FREQ=DAILY;UNTIL=also-broken
X-UNKNOWN-PROP:kept-as-is
SUMMARY:Broken properties, rest still checkable
END:VEVENT
END:VCALENDAR
